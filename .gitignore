# ======================================
# SondeAlert Git Ignore Configuration
# ======================================

# --- Python build / cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# --- Virtual environments ---
.env
venv/
.venv/

# --- VS Code / IDE settings ---
.vscode/
.idea/

# --- Docker data & cache ---
data/
!data/.gitkeep
*.pid
*.sock
*.db
*.sqlite

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Misc ---
*.zip
*.tar
*.gz
*.bak
*.old
